<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Version>4.0.0</Version>
    
    <SignAssembly>True</SignAssembly>
    <AssemblyOriginatorKeyFile>wackermann.snk</AssemblyOriginatorKeyFile>
    
    <NoWarn>1701;1702;IDE0063;IDE0290</NoWarn>
    <LangVersion>latest</LangVersion>

    <!-- NuGet identity -->
    <PackageId>neXn.Ipify</PackageId>
    <PackageVersion>4.0.0</PackageVersion>
    <Title>neXn.Ipify</Title>
    <Authors>Dante Karl Wackermann</Authors>

    <!-- Description -->
    <Description>A lightweight .NET wrapper for the ipify public IP address and IP geolocation APIs.</Description>
    <PackageDescription>A lightweight .NET wrapper for the ipify APIs with support for public IPv4/IPv6 lookup and Geo IPify geolocation data.</PackageDescription>

    <!-- Discoverability -->
    <PackageTags>ipify;ip-address;ipv4;ipv6;geolocation;public-ip;dotnet;csharp</PackageTags>

    <!-- URLs -->
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/spreedated/IpifyLibrary</PackageProjectUrl>
    <RepositoryUrl>https://github.com/spreedated/IpifyLibrary</RepositoryUrl>

    <!-- License -->
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>

    <!-- NuGet presentation -->
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- Copyright -->
    <Copyright>2019-2026 © Dante Karl Wackermann</Copyright>

    <!-- Packing -->
    <IsPackable>true</IsPackable>
    <GeneratePackageOnBuild Condition="'$(Configuration)' == 'Release'">true</GeneratePackageOnBuild>
    <PackageOutputPath>$(OutputPath)</PackageOutputPath>

    <!-- Symbols / debugging -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <DebugType>portable</DebugType>

    <!-- Reproducible builds / repository information -->
    <Deterministic>true</Deterministic>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="\" />
    <None Include="../assets/icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="neXn.Analyzers" Version="10.0.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
